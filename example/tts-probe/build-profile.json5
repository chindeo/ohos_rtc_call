{
  // 签名材料由开发者在 DevEco 里维护（Project Structure → Signing Configs → Automatically generate
  // signature），口令不进 Git；借用别的项目的 profile 时要连 product 的 bundleName 一起改，见 README。
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "targetSdkVersion": 12,
        "compatibleSdkVersion": 12,
        "compileSdkVersion": 12,
        "runtimeOS": "OpenHarmony",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "bundleName": "com.chindeo.ttprobe",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
